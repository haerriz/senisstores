<?php
/** @var \Magento\Backend\Block\Template $block */
$previewUrl = $block->getUrl('*/*/previewAjax');
?>
<!-- Inject the "Preview Feed" button dynamically next to the Save buttons using JS -->
<div id="feed-preview-container" data-bind="scope: 'feedPreview'">
    <div id="feed-preview-modal" style="display:none;" title="<?= __('Live Feed Preview (5 Items)') ?>">
        <div data-bind="visible: isLoading" style="text-align:center; padding: 40px;">
            <div class="spinner"></div>
            <p><?= __('Generating preview in memory based on your current mapping...') ?></p>
        </div>
        
        <div data-bind="visible: !isLoading() && !hasError()">
            <pre style="background: #1e1e1e; color: #d4d4d4; padding: 15px; border-radius: 5px; overflow-x: auto; max-height: 500px;"><code data-bind="text: previewContent"></code></pre>
        </div>
        
        <div data-bind="visible: hasError" style="color: #e02b27; padding: 20px; background: #fae5e5; border: 1px solid #e02b27; border-radius: 4px;">
            <strong><?= __('Preview Failed:') ?></strong>
            <span data-bind="text: errorMessage"></span>
        </div>
    </div>
</div>

<script type="text/x-magento-init">
{
    "#feed-preview-container": {
        "Magento_Ui/js/core/app": {
            "components": {
                "feedPreview": {
                    "component": "Haerriz_GoogleShoppingFeed/js/components/preview-modal",
                    "previewUrl": "<?= $previewUrl ?>"
                }
            }
        }
    }
}
</script>
<style>
    .spinner { border: 4px solid rgba(0, 0, 0, 0.1); width: 36px; height: 36px; border-radius: 50%; border-left-color: #007bdb; animation: spin 1s linear infinite; margin: 0 auto; }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
</style>
