<?php
/** @var \Magento\Backend\Block\Template $block */
$attributesUrl = $block->getUrl('*/*/attributesAjax');
?>
<div id="visual-mapper-container" data-bind="scope: 'visualMapper'" style="display: none; margin-top: 20px;">
    
    <div style="background: #f4f4f4; border: 1px solid #d1d1d1; border-radius: 4px; padding: 20px;">
        <h3 style="margin-top:0; border-bottom:1px solid #ccc; padding-bottom:10px;"><?= __('Visual Attribute Mapping') ?></h3>
        
        <div data-bind="visible: isLoading" style="padding: 20px; text-align: center;">
            <strong><?= __('Loading catalog attributes...') ?></strong>
        </div>

        <div data-bind="visible: !isLoading()">
            <table class="data-grid" style="width:100%; background: #fff;">
                <thead>
                    <tr>
                        <th class="data-grid-th" style="width:30%"><?= __('Feed Field (e.g., g:title)') ?></th>
                        <th class="data-grid-th" style="width:40%"><?= __('Magento Attribute') ?></th>
                        <th class="data-grid-th" style="width:20%"><?= __('Modifiers') ?></th>
                        <th class="data-grid-th" style="width:10%"><?= __('Action') ?></th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: mappings">
                    <tr>
                        <td style="padding: 10px; border-bottom: 1px solid #e3e3e3;">
                            <input type="text" class="admin__control-text" data-bind="value: field, valueUpdate: 'keyup'" placeholder="g:id" />
                        </td>
                        <td style="padding: 10px; border-bottom: 1px solid #e3e3e3;">
                            <select class="admin__control-select" data-bind="options: $parent.magentoAttributes, optionsText: 'label', optionsValue: 'code', value: attribute">
                            </select>
                        </td>
                        <td style="padding: 10px; border-bottom: 1px solid #e3e3e3;">
                            <div style="font-size:11px; margin-bottom:5px; color:#666;" data-bind="text: modifiers().length ? modifiers().join(', ') : 'None'"></div>
                            <button type="button" class="action-secondary" style="padding: 3px 8px; font-size:12px;" data-bind="click: $parent.promptModifiers.bind($parent, $data)">+ Mod</button>
                        </td>
                        <td style="padding: 10px; border-bottom: 1px solid #e3e3e3;">
                            <button type="button" class="action-delete" data-bind="click: $parent.removeMapping.bind($parent, $data)">
                                <span>Delete</span>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
            
            <div style="margin-top: 15px; text-align: right;">
                <button type="button" class="action-primary" data-bind="click: addMapping">
                    <span><?= __('Add Field Mapping') ?></span>
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/x-magento-init">
{
    "#visual-mapper-container": {
        "Magento_Ui/js/core/app": {
            "components": {
                "visualMapper": {
                    "component": "Haerriz_GoogleShoppingFeed/js/components/visual-mapper",
                    "attributesUrl": "<?= $attributesUrl ?>"
                }
            }
        }
    }
}
</script>
