<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::marketing">
                    <resource id="Haerriz_GoogleShoppingFeed::feed_management" title="Google Shopping Feeds" sortOrder="10">
                        <resource id="Haerriz_GoogleShoppingFeed::feed_profiles" title="Manage Profiles" sortOrder="10"/>
                        <resource id="Haerriz_GoogleShoppingFeed::generate" title="Generate/Preview Feed" sortOrder="20"/>
                        <resource id="Haerriz_GoogleShoppingFeed::download" title="Download Feeds" sortOrder="30"/>
                        <resource id="Haerriz_GoogleShoppingFeed::history" title="History &amp; Logs" sortOrder="40"/>
                        <resource id="Haerriz_GoogleShoppingFeed::cron" title="Cron / Jobs" sortOrder="50"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Haerriz_GoogleShoppingFeed::config" title="Google Shopping Feed Configuration" sortOrder="50">
                                <resource id="Haerriz_GoogleShoppingFeed::credentials" title="API Credentials" sortOrder="10"/>
                            </resource>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
