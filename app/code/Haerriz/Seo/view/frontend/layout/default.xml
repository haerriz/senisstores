<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="after.body.start">
            <block class="Magento\Framework\View\Element\Template" name="haerriz.gtm" template="Haerriz_Seo::analytics/gtm.phtml" before="-"/>
        </referenceContainer>
        <referenceContainer name="footer-container">
            <block class="Magento\Framework\View\Element\Template" name="haerriz.seo.internal.links" template="Haerriz_Seo::internal-links.phtml" after="-"/>
