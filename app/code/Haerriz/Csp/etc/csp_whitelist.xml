<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="frame-src">
            <values>
                <value id="google_maps" type="host">https://www.google.com</value>
                <value id="google_maps_www" type="host">*.google.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="wikimedia" type="host">https://upload.wikimedia.org</value>
                <value id="flaticon" type="host">https://cdn-icons-png.flaticon.com</value>
                <value id="google_static" type="host">https://maps.googleapis.com</value>
                <value id="google_static_gstatic" type="host">https://maps.gstatic.com</value>
            </values>
        </policy>
        <policy id="script-src">
            <values>
                <value id="google_tag_manager" type="host">https://www.googletagmanager.com</value>
                <value id="google_analytics" type="host">https://www.google-analytics.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="google_analytics_connect" type="host">https://www.google-analytics.com</value>
                <value id="google_analytics_region" type="host">https://region1.google-analytics.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
