                  placeholder="<?= $escaper->escapeHtmlAttr(__('Try: show 3 premium courses, costliest first')) ?>"></textarea>
        <button type="submit" class="agentic-commerce__send" data-agentic-send><?= $escaper->escapeHtml(__('Send')) ?></button>
    </form>
    <p class="agentic-commerce__status" data-agentic-status role="status"></p>
