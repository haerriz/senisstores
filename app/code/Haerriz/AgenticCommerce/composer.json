{
    "name": "haerriz/module-agentic-commerce",
    "description": "Agentic storefront platform for Magento Open Source and Adobe Commerce: governed conversational access to catalog, inventory/MSI availability, pricing, product options, cart, checkout, customer account, newsletter, reviews, alerts, wishlist, orders, recommendations, CMS knowledge, GraphQL/headless/PWA, Hyva and Luma.",
    "type": "magento2-module",
    "version": "5.0.0",
    "license": [
        "OSL-3.0"
    ],
    "require": {
        "php": ">=8.1 <8.5",
        "magento/framework": "^103.0",
        "magento/module-authorization": "*",
        "magento/module-catalog": "*",
        "magento/module-catalog-search": "*",
        "magento/module-checkout": "*",
        "magento/module-cms": "*",
        "magento/module-config": "*",
        "magento/module-cron": "*",
        "magento/module-customer": "*",
        "magento/module-eav": "*",
        "magento/module-graph-ql": "*",
        "magento/module-quote": "*",
        "magento/module-store": "*",
        "magento/module-webapi": "*",
        "magento/module-wishlist": "*",
        "magento/module-sales": "*",
        "magento/module-directory": "*",
        "magento/module-newsletter": "*",
        "magento/module-review": "*",
        "magento/module-product-alert": "*",
        "magento/module-configurable-product": "*",
        "magento/module-bundle": "*",
        "magento/module-downloadable": "*",
        "magento/module-grouped-product": "*",
        "magento/module-payment": "*",
        "magento/module-shipping": "*",
        "magento/module-catalog-inventory": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Haerriz\\AgenticCommerce\\": ""
        }
    },
    "suggest": {
        "magento/module-inventory-sales-api": "Enables MSI website-stock salable quantity and requested-quantity checks; CatalogInventory remains the fallback."
    }
}
